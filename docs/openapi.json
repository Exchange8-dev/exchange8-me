          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyModeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sets disabled"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets/enforce": {
      "post": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_mode_enforce",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyModeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sets switched to enforce mode"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets/shadow": {
      "post": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_mode_shadow",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyModeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sets switched to shadow mode"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets/{name}": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_get_set",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Policy set name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The policy set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicySetDetail"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          },
          "404": {
            "description": "Unknown policy set name"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "put": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_put_set",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Policy set name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutPolicySetBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Policy set stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicySetMutated"
                }
              }
            }
          },
          "400": {
            "description": "Invalid policy set definition"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "delete": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_delete_set",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Policy set name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Policy set deleted"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets/{name}/test": {
      "post": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_test_set",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Policy set name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestPolicySetBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Dry-run decision trace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyTestOutcome"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/relations": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_list_relations",
        "responses": {
          "200": {
            "description": "ReBAC relations of this service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RelationRecordRow"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "put": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_put_relation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutRelationBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Relation stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelationUpserted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid relation definition"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "delete": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_delete_relation",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "Relation id to delete",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Relation deleted"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/relations/check": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_check_relation",
        "parameters": [
          {
            "name": "subject",
            "in": "query",
            "description": "Subject key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "relation",
            "in": "query",
            "description": "Relation name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "object",
            "in": "query",
            "description": "Object key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The check verdict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelationCheckResult"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/ui/auctions": {
      "get": {
        "tags": [
          "exchange8-admin"
        ],
        "summary": "`GET /v1/admin/ui/auctions` - the auctions RFW page definition.",
        "operationId": "admin_ui_auctions_page",
        "responses": {
          "200": {
            "description": "RFW page definition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminRfwPage"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": []
      }
    },
    "/v1/admin/ui/engine": {
      "get": {
        "tags": [
          "exchange8-admin"
        ],
        "summary": "`GET /v1/admin/ui/engine` - the RFW page definition (Dash renders it).\nGate: the page's declared scope (the `exchange8:order:read` admin\nvocabulary; the step-5 mirror admits the platform-admin trio).",
        "operationId": "admin_ui_engine_page",
        "responses": {
          "200": {
            "description": "RFW page definition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminRfwPage"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": []
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Spec wrapper for the shell-owned `/v1/health` mount.",
        "operationId": "me_health",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealth"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "AdminRfwPage": {
        "description": "The RFW page-definition document (transparent renderer-contract JSON;\nthe local auction/engine page builder emits the renderer contract)."
      },
      "AttributeUpserted": {
        "type": "object",
        "description": "An attribute upsert result.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `upserted`."
          }
        }
      },
      "AuctionRow": {
        "type": "object",
        "description": "One auction row of the sessions table.",
        "required": [
          "id",
          "auction_type",
          "state",
          "scheduled_at"
        ],
        "properties": {
          "auction_type": {
            "type": "string",
            "description": "Session type (CHECK key)."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Session id."
          },
          "instrument_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Instrument the session trades."
          },
          "scheduled_at": {
            "type": "string",
            "description": "Scheduled session time."
          },
          "state": {
            "type": "string",
            "description": "Durable lifecycle state (CHECK key)."
          },
          "uncross_price": {
            "type": [
              "string",
              "null"
            ],
            "description": "Clearing price (null until uncrossed)."
          }
        }
      },
      "Decision": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "decision"
            ],
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "allow"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason",
              "decision"
            ],
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "deny"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "EngineInstrumentRow": {
        "type": "object",
        "description": "One instrument row of the engine snapshot table.",
        "required": [
          "instrument_id",
          "status",
          "open_orders"
        ],
        "properties": {
          "best_ask": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Best ask (raw ticks; `null` = empty)."
          },
          "best_bid": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Best bid (raw price ticks; `null` = empty)."
          },
          "instrument_id": {
            "type": "integer",
            "format": "int32",
            "description": "Instrument id (the engine's u32 space).",
            "minimum": 0
          },
          "open_orders": {
            "type": "integer",
            "format": "int64",
            "description": "Resting open-order count across both books.",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "description": "Trading status key."
          }
        }
      },
      "LiveHealth": {
        "type": "object",
        "description": "The `GET /v1/health` liveness payload every service returns: the\nstatus string, the serving service's short name, build identity, and\n(when the process tracks them) the count of live connections.\n`service` and `active_connections` stay absent when a service does\nnot set them (e.g. the bus mounts the generic handler).",
        "required": [
          "status"
        ],
        "properties": {
          "active_connections": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Live socket count when the traffic counter is mounted."
          },
          "build": {
            "type": [
              "string",
              "null"
            ],
            "description": "Build hash (`sentin8::build_info::build_hash()`)."
          },
          "service": {
            "type": [
              "string",
              "null"
            ],
            "description": "The serving service's short name (absent when the generic handler\ndoes not carry one)."
          },
          "status": {
            "type": "string",
            "description": "Always `ok` on a live instance."
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Build identity id (`sentin8::build_info::id()`)."
          }
        }
      },
      "PolicyModeBody": {
        "type": "object",
        "description": "`POST /v1/admin/policy-sets/{mode}` body (RFW row actions).",
        "required": [
          "policy_set_name"
        ],
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "policy_set_name": {
            "type": "string"
          }
        }
      },
      "PolicySetDetail": {
        "type": "object",
        "description": "One policy set in the detail view (adds the full policy text).",
        "required": [
          "policy_set_name",
          "description",
          "policies",
          "origin",
          "mode",
          "version",
          "enabled",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "description": "Creation instant (RFC 3339)."
          },
          "description": {
            "type": "string",
            "description": "Human description."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the set participates in evaluation."
          },
          "mode": {
            "type": "string",
            "description": "Evaluation mode."
          },
          "origin": {
            "type": "string",
            "description": "Row origin (`platform`/`tenant`)."
          },
          "policies": {
            "type": "string",
            "description": "The full policy text (Shield policy language)."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name."
          },
          "schema": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional schema text bound to the set."
          },
          "updated_at": {
            "type": "string",
            "description": "Last update instant (RFC 3339)."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Monotonic revision."
          }
        }
      },
      "PolicySetMutated": {
        "type": "object",
        "description": "A stored policy-set mutation result.",
        "required": [
          "policy_set_name",
          "version",
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "description": "The evaluation mode after the mutation."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "The revision after the mutation."
          }
        }
      },
      "PolicySetRow": {
        "type": "object",
        "description": "One policy set in the list view (the RFW row shape).",
        "required": [
          "id",
          "policy_set_name",
          "description",
          "origin",
          "mode",
          "version",
          "enabled",
          "policies_len",
          "updated_at"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "Human description."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the set participates in evaluation."
          },
          "id": {
            "type": "string",
            "description": "The set name; doubles as the RFW row id."
          },
          "mode": {
            "type": "string",
            "description": "Evaluation mode (`shadow`/`enforced`)."
          },
          "origin": {
            "type": "string",
            "description": "Row origin (`platform` enroll-managed vs `tenant`)."
          },
          "policies_len": {
            "type": "integer",
            "format": "int64",
            "description": "Number of policy statements in the set."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name."
          },
          "updated_at": {
            "type": "string",
            "description": "Last update instant (RFC 3339)."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Monotonic revision."
          }
        }
      },
      "PolicyTestOutcome": {
        "type": "object",
        "description": "A dry-run (test) outcome; nothing was stored.",
        "required": [
          "policy_set_name",
          "action",
          "decision",

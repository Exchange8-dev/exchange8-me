{
  "openapi": "3.1.0",
  "info": {
    "title": "exchange8-me",
    "description": "Sentin8 exchange8 me service.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/admin/attributes": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_list_attributes",
        "responses": {
          "200": {
            "description": "Principal attributes of this service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PrincipalAttr"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "put": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_put_attribute",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutAttributeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Attribute stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttributeUpserted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid attribute definition"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "delete": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_delete_attribute",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "Attribute id to delete",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attribute deleted"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/auctions": {
      "post": {
        "tags": [
          "exchange8-admin"
        ],
        "summary": "`POST /v1/admin/auctions` - the durable auction sessions (RFW table\ndata; RLS-scoped read of `me.auction`).",
        "operationId": "auctions_snapshot",
        "responses": {
          "200": {
            "description": "Auction snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuctionRow"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": []
      }
    },
    "/v1/admin/engine": {
      "post": {
        "tags": [
          "exchange8-admin"
        ],
        "summary": "`POST /v1/admin/engine` - the engine snapshot (RFW table data).",
        "description": "Read-only: the engine state is read in-process under the shard locks\n(books are memory-resident; the RLS pipeline applies because the reader\nis the caller's own process and the payload is engine state, not tenant\nrows). Gate: the declared `exchange8:order:read` admin scope.",
        "operationId": "engine_snapshot",
        "responses": {
          "200": {
            "description": "Engine snapshot rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EngineInstrumentRow"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": []
      }
    },
    "/v1/admin/policy-sets": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_list_sets",
        "responses": {
          "200": {
            "description": "Policy sets of this service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PolicySetRow"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets/disable": {
      "post": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_mode_disable",
